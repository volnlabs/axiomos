{
  "common_environment": {
    "CARGO_TARGET_DIR": "/home/utkarsh/Work/axiomOS/target"
  },
  "commands": [
    [
      "cargo",
      "test",
      "-p",
      "kernel",
      "--test",
      "bpf_update_transaction",
      "--features",
      "kernel_bpf/embedded-profile,bpf-unsigned-development,bpf-update-diagnostics",
      "--",
      "--test-threads=1"
    ],
    [
      "cargo",
      "test",
      "-p",
      "kernel_bpf",
      "--features",
      "loom-model,cloud-profile",
      "--test",
      "concurrency_model"
    ],
    [
      "cargo",
      "test",
      "-p",
      "kernel_bpf",
      "--no-default-features",
      "--features",
      "cloud-profile"
    ],
    [
      "cargo",
      "check",
      "-p",
      "kernel_bpf",
      "--no-default-features",
      "--features",
      "embedded-profile"
    ],
    [
      "cargo",
      "check",
      "-p",
      "kernel",
      "--target",
      "aarch64-unknown-none",
      "--no-default-features",
      "--features",
      "cloud-profile,virt,bpf-update-diagnostics,bpf-unsigned-development"
    ],
    [
      "env",
      "AXIOM_BPF_TRUSTED_KEY_PATH=/tmp/axiomos-test-trusted-key.bin",
      "cargo",
      "check",
      "-p",
      "kernel",
      "--target",
      "x86_64-unknown-none",
      "--no-default-features",
      "--features",
      "cloud-profile,x86_64_arch"
    ],
    [
      "cargo",
      "check",
      "--locked",
      "-p",
      "kernel",
      "--lib",
      "--target",
      "aarch64-unknown-none",
      "--features",
      "embedded-profile,bpf-unsigned-development"
    ],
    [
      "env",
      "AXIOMOS_QEMU_AUDIT_NAME=axiomos-update-probe",
      "AXIOMOS_QEMU_DISABLE_MONITOR=1",
      "timeout",
      "55s",
      "cargo",
      "run",
      "--locked",
      "--release",
      "--features",
      "bpf-update-probe,audit-diagnostics",
      "--",
      "--headless",
      "--smp",
      "1",
      "--mem",
      "1G"
    ],
    [
      "python3",
      "-m",
      "unittest",
      "discover",
      "-s",
      "scripts/benchmark",
      "-p",
      "test_update*.py"
    ]
  ],
  "qemu_exit": 124,
  "qemu_required_markers": [
    "BPF_UPDATE_TRANSACTION_OK interpreter_a_b_a=true stale_rejected=true physical_output=false",
    "BPF_HOOK_SNAPSHOT_SMP_OK",
    "BPF_HANDLE_REUSE_OK",
    "BPF_OWNER_EXIT_OK",
    "BPF_OWNER_RECLAIM_OK"
  ]
}
